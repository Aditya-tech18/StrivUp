# Copy to .env.local and fill in. Never commit real values.

# Supabase (existing app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, used by the existing auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# STRIVY chat
STRIVY_ENABLED=true

# STRIVY text model: OpenRouter FREE models only (₹0). SERVER ONLY: never
# prefix these with NEXT_PUBLIC_. Get a key at https://openrouter.ai/keys and
# keep the account at zero credits (or give the key a $0 limit) so nothing can
# ever be charged. Without a key, STRIVY uses its built-in grounded replies.
OPENROUTER_API_KEY=
# Leave as openrouter/free (OpenRouter's Free Models Router). Only
# "openrouter/free" or a model id ending in ":free" is accepted; anything else
# is ignored and openrouter/free is used.
OPENROUTER_MODEL=openrouter/free
# How long to wait for the model before using the built-in reply (1000-60000 ms).
STRIVY_LLM_TIMEOUT_MS=30000
# Optional kill switch: set to false to turn the text model off entirely.
# STRIVY_LLM_ENABLED=true
# Development only: log intent / model / fallback / timings for each STRIVY
# reply to the server console (never shown in the chat)
STRIVY_DEBUG=false

# STRIVY voice. Works with no key in browsers that have speech recognition
# (Chrome, Edge, Safari). GEMINI_API_KEY is optional, SERVER ONLY and used for
# voice transcription only (never for chat). Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# auto (Gemini's automatic language detection when GEMINI_API_KEY is set, else browser speech) | browser | gemini
STRIVY_VOICE_PROVIDER=auto
# Optional; default gemini-3.5-flash-lite
GEMINI_VOICE_MODEL=
# Optional in-app alerts from check-ins (needs migration 20260929_strivy_notifications.sql)
STRIVY_NOTIFICATIONS_ENABLED=false

# STRIVY push (Phase 4; needs migration 20261001_strivy_push.sql)
STRIVY_PUSH_ENABLED=false
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Server only. Used by the push scheduler; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# 16+ random characters. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
# automatically; the existing /api/activity/cron needs it too.
CRON_SECRET=

# Development only: the "Send test STRIVY notification" button and /api/strivy/push/dev
STRIVY_PUSH_DEV_TOOLS=false
NEXT_PUBLIC_STRIVY_PUSH_DEV_TOOLS=false
